generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("AURA_DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         String     @default("user")
  address      String?
  phone        String?
  createdAt    DateTime   @default(now())
  cart         Cart?
  orders       Order[]
  reviews      Review[]
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  imageUrl  String
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id            String      @id @default(cuid())
  title         String
  slug          String      @unique
  description   String
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  audience      String
  price         Float
  stockQuantity Int         @default(0)
  sizeOptions   String      @default("[]")
  colorOptions  String      @default("[]")
  imageUrls     String      @default("[]")
  specifications String     @default("{}")
  rating        Float       @default(0)
  reviewCount   Int         @default(0)
  popularity    Int         @default(0)
  badge         String?
  leatherType   String      @default("Full-grain leather")
  careInstructions String   @default("Wipe with a soft, dry cloth. Condition occasionally with a leather-safe balm.")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  cartItems     CartItem[]
  orderItems    OrderItem[]
  reviews       Review[]
  @@index([categoryId])
  @@index([audience])
  @@index([price])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
  createdAt DateTime   @default(now())
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  size      String   @default("")
  color     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([cartId, productId, size, color])
}

model Order {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  totalAmount     Float
  subtotal        Float
  shippingFee     Float
  estimatedTax    Float
  shippingAddress String
  status          String      @default("Pending")
  paymentStatus   String      @default("Pending")
  createdAt       DateTime    @default(now())
  items           OrderItem[]
  @@index([userId, createdAt])
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productTitle    String
  imageUrl        String
  priceAtPurchase Float
  quantity        Int
  size            String   @default("")
  color           String   @default("")
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  @@unique([productId, userId])
  @@index([productId, createdAt])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
